# Copy to .env and load with: uv run --env-file .env <command>

# Server bind. Keep 127.0.0.1 locally; containers set 0.0.0.0.
FREYJA_HOST=127.0.0.1
FREYJA_PORT=8000

# Required, no default: it carries credentials. This value matches the local
# Postgres container.
FREYJA_DATABASE_URI=postgresql://freyja:freyja@localhost:5432/freyja

# Model as a LangChain provider-prefixed string. The prefix picks the client
# package, and that client reads its own connection variables; settings never
# see the key. Installed providers: openai, anthropic, openrouter. Keep exactly
# one FREYJA_MODEL line active.

# Self-hosted or any OpenAI-compatible server, such as vLLM or LM Studio.
FREYJA_MODEL=openai:<served model name>
OPENAI_API_KEY=<token, or any non-empty value if the server does not check>
OPENAI_API_BASE=http://<host>:<port>/v1

# Anthropic API directly. Comment out the three lines above, then set:
# FREYJA_MODEL=anthropic:claude-opus-5-5
# ANTHROPIC_API_KEY=
# Optional, only when routing through a proxy or gateway in front of the
# Anthropic API (the Anthropic client reads ANTHROPIC_API_URL, not *_API_BASE):
# ANTHROPIC_API_URL=

# OpenRouter. The id after the prefix is OpenRouter's model slug.
# FREYJA_MODEL=openrouter:anthropic/claude-opus-5-5
# OPENROUTER_API_KEY=
# Optional, only when routing through a proxy in front of openrouter.ai:
# OPENROUTER_API_BASE=
