# Copy to .env and load with: uv run --env-file .env <command>

# Server bind. Keep 127.0.0.1 locally; containers set 0.0.0.0.
FREYJA_HOST=127.0.0.1
FREYJA_PORT=8000

# Required, no default: it carries credentials. This value matches the local
# Postgres container.
FREYJA_DATABASE_URI=postgresql://freyja:freyja@localhost:5432/freyja
# Test-only, read by tests/integration, not by settings. Create the database once with
# `docker compose exec postgres createdb -U freyja freyja_test`.
# FREYJA_TEST_DATABASE_URI=postgresql://freyja:freyja@localhost:5432/freyja_test

# Agent workspace root; skills/ inside it is committed, cases/ is runtime output.
FREYJA_WORKSPACE_DIR=workspace
# Maximum orchestrator steps per run; the run ends with an error event at the limit.
# Middleware nodes count: a plain reply needs about 7 steps and each tool call about 4
# more, so values below 11 stop every tool call.
FREYJA_MAX_STEPS=50
# Expiry of the per-thread run lock, in seconds; a crashed instance frees its thread after this.
FREYJA_RUN_LOCK_TTL_SECONDS=60

# Tool servers reached over MCP, as one JSON object on one line, in single quotes. Each entry
# has exactly one of "command" (the service launches it and stops it) and "url" (a server you
# run on this machine; the host must be localhost or a loopback address). "read_only" lists the
# tools that run without approval; every tool not listed pauses for a decision. "pass_env"
# names the environment variables a launched server receives; put a credential in a variable
# and name it there, never in "args" or a URL. Unset means no tool servers.
# FREYJA_MCP_SERVERS='{"git": {"command": "uvx", "args": ["mcp-server-git", "--repository", "/tmp/freyja-demo-repo"], "read_only": ["git_status", "git_log"]}}'
# Time limit for one tool call, in seconds, including connecting; a call that exceeds it
# returns an error result and the run continues.
FREYJA_MCP_CALL_TIMEOUT_SECONDS=30
# Time limit per server for connecting and listing its tools at startup, in seconds.
FREYJA_MCP_STARTUP_TIMEOUT_SECONDS=20

# Agents reached over A2A, as one JSON object on one line, in single quotes. Each entry has a
# "url" on this machine (the host must be localhost or a loopback address); Freyja reads the
# agent's card from it at startup and sends every request to that host and port. "read_only":
# true lets hand-offs, answers, and cancels to that agent run without approval; without it,
# every message to the agent pauses for a decision. Agent names must differ from tool server
# names. Unset means no agents.
# FREYJA_A2A_AGENTS='{"hello": {"url": "http://127.0.0.1:9999", "read_only": true}, "stub": {"url": "http://localhost:9998"}}'
# How long a hand-off, answer, or cancel waits within a run, in seconds. A task the agent is
# still working on then becomes pending and is reported later in its thread.
FREYJA_A2A_CALL_TIMEOUT_SECONDS=30
# Time limit per agent for reading its card at startup, in seconds.
FREYJA_A2A_STARTUP_TIMEOUT_SECONDS=20
# How often pending tasks are checked and their outcomes delivered, in seconds.
FREYJA_A2A_POLL_INTERVAL_SECONDS=10
# A pending task older than this, counted from its start, is given up, in seconds. Freyja
# sends no cancel; the agent may keep working on it.
FREYJA_A2A_TASK_MAX_AGE_SECONDS=86400
# Attempts for one background run that fails, the first included, and the wait between them
# in seconds. A retry never sends an agent the same message twice.
FREYJA_BACKGROUND_RUN_ATTEMPTS=3
FREYJA_BACKGROUND_RETRY_SECONDS=60

# Model as a LangChain provider-prefixed string. The prefix picks the client
# package, and that client reads its own connection variables; settings never
# see the key. Installed providers: openai, anthropic, openrouter. Keep exactly
# one FREYJA_MODEL line active.

# OpenAI-compatible endpoint. OPENAI_API_KEY can be any non-empty value if the
# server does not check it. OPENAI_API_BASE is optional: leave it unset for
# api.openai.com; set it for a self-hosted server, such as vLLM or LM Studio,
# or to route through a gateway.
FREYJA_MODEL=openai:<served model name>
OPENAI_API_KEY=<key>
OPENAI_API_BASE=http://<host>:<port>/v1

# Anthropic API directly. Comment out the three lines above, then set:
# FREYJA_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-<key>
# Optional, only when routing through a proxy or gateway in front of the
# Anthropic API (the Anthropic client reads ANTHROPIC_API_URL, not *_API_BASE):
# ANTHROPIC_API_URL=https://<host>

# OpenRouter. The id after the prefix is OpenRouter's model slug.
# FREYJA_MODEL=openrouter:anthropic/claude-sonnet-5.5
# OPENROUTER_API_KEY=sk-or-<key>
# Optional, only when routing through a proxy in front of openrouter.ai:
# OPENROUTER_API_BASE=https://<host>/api/v1
