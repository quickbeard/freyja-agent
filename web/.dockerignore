# The build context of the web console's image (web/Dockerfile): the source and the lock
# file. What is installed, built, or written by a test run is made again inside the image.
node_modules/
.next/
out/
build/
coverage/
playwright-report/
test-results/
.vitest/
tsconfig.tsbuildinfo

# Tests are not built into the app.
__tests__/
e2e/
playwright.config.ts
vitest.config.mts
vitest.setup.ts

# Never in an image: a deployment's values, and keys.
.env
.env.*
!.env.example
*.pem

Dockerfile
.dockerignore
