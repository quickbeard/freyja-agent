# Deployment configuration of the web app. It is read in one place, next.config.ts.

# Where the web app's server forwards /api/...: the Freyja service. The browser only ever calls
# the web app's own origin and never learns this address, so the variable has no NEXT_PUBLIC_
# prefix.
#
# `pnpm dev` reads it when it starts. `pnpm build` writes it into the build, and `pnpm start`
# does not read it again: to change the address of a built app, build it again.
FREYJA_API_URL=http://127.0.0.1:8000

# Set to 1 by the build of the container image alone (web/Dockerfile): `pnpm build` then writes
# a standalone server under .next/standalone, which runs without node_modules. Leave it unset
# otherwise: `pnpm start` is not meant to serve such a build.
# FREYJA_WEB_STANDALONE=1

# Read by the standalone server in a container, not by this app's own code, and so not named
# FREYJA_*: HOSTNAME is the address it listens on and PORT the port. The image sets 127.0.0.1
# and 3000.
